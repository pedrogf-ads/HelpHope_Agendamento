#!/usr/bin/env bash
set -euo pipefail

# Análise não destrutiva de possíveis rotas do protótipo.
# Execute na raiz do projeto, onde está a pasta src/.

if [[ ! -d src ]]; then
  echo "Erro: execute este script na raiz do projeto (pasta src/ não encontrada)." >&2
  exit 1
fi

echo "Analisando possíveis rotas e navegações em src/..."

if command -v rg >/dev/null 2>&1; then
  rg -n --glob '*.{js,jsx,ts,tsx}' \
    'createBrowserRouter|createHashRouter|BrowserRouter|HashRouter|<Route\b|useRoutes\(|navigate\(|useNavigate\(|href=|path[[:space:]]*:' src || true
else
  grep -RInE --include='*.js' --include='*.jsx' --include='*.ts' --include='*.tsx' \
    'createBrowserRouter|createHashRouter|BrowserRouter|HashRouter|<Route|useRoutes\(|navigate\(|useNavigate\(|href=|path[[:space:]]*:' src || true
fi

echo "Análise concluída. Confira manualmente os resultados: esta busca não valida rotas em execução."
